# Supabase — Project Settings > API
# Sign-in goes through Supabase Auth with Spotify as the provider, so these are
# the only two values the app itself reads. The anon key is public by design;
# row level security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The Spotify client id and secret are NOT set here. They belong in
# Supabase > Authentication > Providers > Spotify, because the token exchange
# happens on Supabase's side. Never ship a client secret in a frontend build.
