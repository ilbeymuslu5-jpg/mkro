# Spotify — https://developer.spotify.com/dashboard
# Create an app, then add the redirect URI below to its settings verbatim.
# PKCE is used, so no client secret is needed (and none must ever ship here).
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Supabase — Project Settings > API
# The anon key is public by design; row level security is what protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
